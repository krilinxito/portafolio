---
import Icono from './Icono.astro';

interface Props {
  clase?: string;
}
const { clase = '' } = Astro.props;

export const contactos = [
  { icono: 'github' as const, etiqueta: 'GitHub', href: 'https://github.com/krilinxito' },
  {
    icono: 'linkedin' as const,
    etiqueta: 'LinkedIn',
    href: 'https://www.linkedin.com/in/maximiliano-gomez-mallo',
  },
  { icono: 'correo' as const, etiqueta: 'Email', href: 'mailto:barryallen4207@gmail.com' },
];
---
<ul class={`flex list-none items-center gap-5 p-0 ${clase}`}>
  {
    contactos.map((c) => (
      <li>
        <a
          href={c.href}
          class="enlace-icono block text-apagado transition-colors hover:text-filete"
          aria-label={c.etiqueta}
        >
          <Icono nombre={c.icono} tam={24} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /*
    La regla global `a { border-bottom }` vive fuera de @layer, así que gana a la
    utilidad border-0 de Tailwind. El estilo con alcance de componente sí la vence.
  */
  .enlace-icono {
    border-bottom: 0;
  }
</style>
